{
  "name": "skillpulse-lms",
  "version": "1.0.1",
  "description": "LMS",
  "main": "index.js",
  "scripts": {
    "clean": "rm -rf build dist assets/js/admin.min.js assets/js/frontend.min.js",
    "js:build": "webpack --config webpack.config.js",
    "scss:watch": "sass --watch ./src/scss/admin/index.scss:./assets/css/admin.min.css ./src/scss/frontend/index.scss:./assets/css/frontend.min.css ./src/scss/frontend/fullscreen/fullscreen.scss:./assets/css/fullscreen.min.css ./src/js/react-core/admin/pages/wizard/styles/index.scss:./assets/css/wizard.css",
    "scss:build": "sass ./src/scss/admin/index.scss:./assets/css/admin.min.css ./src/scss/frontend/index.scss:./assets/css/frontend.min.css ./src/scss/frontend/fullscreen/fullscreen.scss:./assets/css/fullscreen.min.css ./src/js/react-core/admin/pages/wizard/styles/index.scss:./assets/css/wizard.css",
    "scss:build:prod": "sass --style=compressed ./src/scss/admin/index.scss:./assets/css/admin.min.css ./src/scss/frontend/index.scss:./assets/css/frontend.min.css ./src/scss/frontend/fullscreen/fullscreen.scss:./assets/css/fullscreen.min.css ./src/js/react-core/admin/pages/wizard/styles/index.scss:./assets/css/wizard.css",
    "js:build:prod": "cross-env NODE_ENV=production webpack --config webpack.prod.js",
    "js:watch": "cross-env NODE_ENV=development webpack --config webpack.dev.js --watch",
    "test": "./bin/test-local.sh",
    "test:unit": "./bin/test-local.sh --suite=unit",
    "test:integration": "./bin/test-local.sh --suite=integration",
    "test:setup": "./bin/test-local.sh --setup",
    "wp-env": "wp-env",
    "wp-env:start": "wp-env start",
    "wp-env:stop": "wp-env stop",
    "wp-env:clean": "wp-env clean",
    "wp-env:test": "wp-env run tests-cli --env-cwd=wp-content/plugins/skillpulse-lms vendor/bin/phpunit",
    "wp-env:setup": "./bin/test-local.sh --env=wp-env --setup",
    "lint": "eslint src/js/admin/**/*.js src/js/frontend/**/*.js",
    "lint:fix": "eslint src/js/admin/**/*.js src/js/frontend/**/*.js --fix",
    "lint:php": "composer cs:check",
    "lint:php:fix": "composer cs:fix",
    "build": "npm run js:build && npm run scss:build",
    "build:test": "npm run build && npm run test:php",
    "replace-version": "grunt replace-version"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xpertiescoder/skillpulse-lms.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/xpertiescoder/skillpulse-lms/issues"
  },
  "homepage": "https://github.com/xpertiescoder/skillpulse-lms#readme",
  "dependencies": {
    "@wordpress/block-editor": "^12.0.0",
    "@wordpress/format-library": "^4.0.0",
    "@wordpress/rich-text": "^6.0.0",
    "react": "^18.3.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.3.1",
    "styled-components": "^5.3.0",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-react": "^7.26.3",
    "@wordpress/env": "^10.38.0",
    "@wordpress/scripts": "^19.2.4",
    "babel-loader": "^9.2.1",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "gettext-extractor": "^4.0.1",
    "grunt": "^1.6.1",
    "grunt-replace": "^2.0.2",
    "grunt-wp-i18n": "^1.0.4",
    "lodash": "^4.17.21",
    "sass": "^1.83.0",
    "sass-loader": "^16.0.4",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.10",
    "webpack": "^5.90.0",
    "webpack-merge": "^6.0.1"
  },
  "SPLMSVersion": "1.0.1"
}
