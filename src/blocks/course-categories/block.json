{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "splms/course-categories",
	"title": "Course Categories",
	"category": "skillpulse-lms",
	"description": "Display course categories as a grid of cards with course counts.",
	"keywords": [ "categories", "courses", "taxonomy", "lms" ],
	"textdomain": "skillpulse-lms",
	"icon": "category",
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	},
	"attributes": {
		"columns": { "type": "number", "default": 4 },
		"showCount": { "type": "boolean", "default": true },
		"showDescription": { "type": "boolean", "default": false },
		"hideEmpty": { "type": "boolean", "default": true },
		"categories": { "type": "array", "default": [] }
	}
}
